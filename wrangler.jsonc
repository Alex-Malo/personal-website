// Cloudflare Workers config: serves the built site from ./dist.
// The small Worker in worker/index.js only runs for "/" to pick the language.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"]
  },
  // The site lives only at alexmalo.cat: no copy at personal-website.<account>.workers.dev,
  // which would sit outside the domain's Cloudflare settings (bot blocking, HTTPS rules).
  "workers_dev": false,
  // Branch previews still get their own workers.dev URL.
  "preview_urls": true,
  // Lets branch builds publish a preview URL (`wrangler preview`). Empty on purpose: everything else is inherited.
  "previews": {}
}
