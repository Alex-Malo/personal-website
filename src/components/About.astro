---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { text, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang];

// The photo is optional: drop src/assets/alex.jpg (or .jpeg/.png/.webp) in and it appears.
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/alex.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(found)[0]?.default;
---

<Base lang={lang} title={t.title} description={t.description}>
  <div class:list={['about', { 'about--no-photo': !photo }]}>
    {photo && (
      <div class="about-photo">
        <Image src={photo} alt="Alex Malo" width={920} widths={[460, 920]} sizes="(min-width: 40rem) 230px, 100vw" loading="eager" />
      </div>
    )}
    <div class="about-text">
      <h1>{t.title}</h1>
      <p class="tagline">{t.tagline}</p>
      {t.about.map((p) => <p set:html={p} />)}
    </div>
  </div>
</Base>
