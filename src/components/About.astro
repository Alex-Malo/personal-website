---
import Base from '../layouts/Base.astro';
import { text, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang];
---

<Base lang={lang} title={t.title} description={t.description}>
  <section class="intro">
    <h1>{t.title}</h1>
    <p class="tagline">{t.tagline}</p>
  </section>

  <section>
    {t.about.map((p) => <p>{p}</p>)}
  </section>
</Base>
