---
import { languages, type Lang } from '../i18n';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  // Path after the language prefix, e.g. "" for the home page, "blog/" later.
  path?: string;
}

const { lang, title, description, path = '' } = Astro.props;
const site = Astro.site!;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(`/${lang}/${path}`, site)} />
    {Object.keys(languages).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(`/${l}/${path}`, site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(`/en/${path}`, site)} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={`/${lang}/`}>Alex Malo</a>
      <nav class="lang-switch" aria-label="Language">
        {(Object.keys(languages) as Lang[]).map((l) => (
          <a href={`/${l}/${path}`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
            {l.toUpperCase()}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
